{
  "name": "sudyka.net",
  "version": "2.0.0",
  "private": true,
  "description": "Personal site for sudyka.net, built with Eleventy.",
  "homepage": "https://sudyka.net",
  "scripts": {
    "start": "eleventy --serve",
    "build": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\" && eleventy && node scripts/check-indieweb.js",
    "check": "node scripts/check-indieweb.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.7"
  },
  "devDependencies": {
    "microformats-parser": "2.0.6"
  }
}
